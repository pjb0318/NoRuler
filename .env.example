# 로컬 개발용 (npm run dev / npm run preview)
GEMINI_API_KEY=

# 공개 배포(Cloudflare Pages)에서 Turnstile 위젯을 켤 때만 설정 (Build-time Vite 변수)
# 로컬 개발 시에는 비워 두면 Turnstile 없이 동작합니다.
VITE_TURNSTILE_SITE_KEY=

# Cloudflare Pages Functions 서버 비밀키 (Dashboard -> Settings -> Variables and Secrets에 Secret으로 등록)
TURNSTILE_SECRET_KEY=

# 선택: 추가 허용 Origin (쉼표 구분, 커스텀 도메인 등)
# ALLOWED_ORIGINS=https://noruler.example.com

# 선택: 요청 횟수 제한 기본값
# RATE_LIMIT_PER_MIN=4
# RATE_LIMIT_PER_DAY=20
# RATE_LIMIT_GLOBAL_PER_DAY=150
# MAX_CONCURRENT_REQUESTS=3
